# 新版；实际密钥只放本地.env，不提交Git
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=
OWNER_USER_ID=0
ALLOWED_CHAT_ID=0
INTERNAL_CHAT_ID=0
IDENTITY_MODE=telegram
MEMBERSHIP_REQUIRED=true
# 初次部署及验收必须 trial；正式切换使用 scripts/cutover.py。
RUN_MODE=trial
TRIAL_RUN_ID=company-trial
TEAM_TIMEZONE=Asia/Shanghai
REPORT_VERSION=2
PROGRESS_THREAD_ID=0
TRAINING_THREAD_ID=0
MANAGEMENT_THREAD_ID=0
# 新工作群日报必须填写实际非默认话题ID。0表示未绑定，不能表示General。
REPORT_THREAD_ID=0
DATA_DIR=data/company-trial
BACKUP_DIR=data/company-trial/backups
AM_START=12:00
AM_END=17:00
PM_START=19:00
PM_END=00:00
REPORT_OPEN=23:00
REPORT_DEADLINE=00:00
SUMMARY_TIME=00:05
REPORT_OPEN_DAY_OFFSET=0
REPORT_DEADLINE_DAY_OFFSET=1
SUMMARY_DAY_OFFSET=1
REPORT_TIMES_CONFIRMED=true
# 仅保留配置，业务调度还需要数据库确认；本次保持关闭
SCHEDULE_ENABLED=false
# 沿用，尚未确认
WORKDAYS=0,1,2,3,4
CLICK_COOLDOWN_SECONDS=2
TRAINING_MODE=directory
AI_ENABLED=false
FREE_PROJECT_CONFIRMED=false
BACKUP_RETENTION_DAYS=14
MAX_FILE_MB=10

# 旧工作台只保留历史，新任务使用独立阶段进度库。
# 没有 artifact-tool 时由锁定 openpyxl 兼容生成器导出。

# 工作进度 Mini App：仅在固定 HTTPS 部署、BotFather 和访问授权均验证后开启。
PROGRESS_MINIAPP_ENABLED=false
PROGRESS_MINIAPP_LINK=
PROGRESS_MINIAPP_ORIGIN=
PROGRESS_MINIAPP_BRIDGE=false
PROGRESS_BRIDGE_SECRET=
# 私有 Sites 服务访问凭据，仅本地保管；不写入前端或交付包。
PROGRESS_SITES_AUTH=
# 可选本地 HTTP 调试源站，默认仅监听127.0.0.1，不作为员工访问地址。
PROGRESS_MINIAPP_SERVER=false
PROGRESS_MINIAPP_PORT=8765

# 只填写本公司的机器人用户名；实际凭据不写入示例。
BOT_USERNAME=
PROGRESS_EXCEL_PATH=
# 仅本项目所有者独立测试；另一公司默认关闭。
FINAL_VERIFY_ENABLED=false
PROGRESS_SITES_PRIVATE=false

# 可选：只向已存在目录同步两份Excel，默认关闭。Windows实际桌面可写desktop:文件夹名称。
DESKTOP_HISTORY_DIR=
